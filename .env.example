# مسیر پایگاه داده (SQLite)
DATABASE_URL="file:./club.db"

# کلید امن برای امضای نشست کاربران — حتماً یک رشته تصادفی طولانی قرار دهید
# تولید: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# اطلاعات مدیر اولیه سامانه (در اجرای seed ساخته می‌شود)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@1234"
